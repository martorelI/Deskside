root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,slnx}]
indent_size = 2

# Directory names and attributes are compared ignoring case (as Active Directory does) and everything sent to the
# directory uses the invariant culture. In the product code every comparison and every format must say which one.
[src/**.cs]
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
