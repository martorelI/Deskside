  "Password": {
    "Generate": true,
    "Length": 16,
    "MinimumLength": 12
  },
  "Offboarding": {
    "DescriptionPattern": "Disabled {date} | {ticket} | {reason} | {operator}"
  },
  "Report": {
    "InactiveDays": 90,
    "ExpiryWarningDays": 14,
    "BadPasswordThreshold": 3,
    "MachinePasswordMaxDays": 60,
    "QueryAllDCs": false
  },
